# ─── Docker Environment Variables ────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# NEVER commit real secrets to version control.

# PostgreSQL Credentials
POSTGRES_DB=drupal
POSTGRES_USER=drupal
POSTGRES_PASSWORD=drupal_secret

# Drupal Hash Salt (generate a unique one for production)
DRUPAL_HASH_SALT=change_this_to_a_long_random_string_for_production

# Site name & admin (used during Drush site-install)
DRUPAL_SITE_NAME="Enterprise AI Knowledge Hub"
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASSWORD=admin123
DRUPAL_ADMIN_EMAIL=admin@example.com
